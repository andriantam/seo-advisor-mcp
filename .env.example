# These are set as environment variables when you register the server with Claude
# (see docs/install.md). This file is only a reference; the server does not read .env itself.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
GSC_SITE_URL=sc-domain:example.com
GA_PROPERTY_ID=123456789
PSI_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
